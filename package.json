{
  "name": "skill-doctor",
  "version": "0.3.5",
  "private": true,
  "description": "Evidence-based Skill linting, patch debt review and regression evaluation",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "skill-doctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "doctor": "node src/cli.ts",
    "verify": "node scripts/verify.mjs"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}
