  "category": "regression-cases",
  "status": "ready",
  "input": "{\"sku\":\"ITEM-001\",\"quantity\":0}",
  "context": "输入为一个 JSON 库存记录，请按 Skill 字段契约规范化。",
  "expected_behavior": [
    "明确提供的数量 0 保留为 0。"
