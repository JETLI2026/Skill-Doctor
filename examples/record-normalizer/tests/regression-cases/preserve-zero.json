  "forbidden_behavior": [
    "将 0 当作缺失并回填成 1。"
  ],
  "assertions": [
    {
      "id": "exact-record",
      "type": "json_equals",
      "value": {
        "sku": "ITEM-001",
        "quantity": 0
      }
