  ],
  "source_rule": [
    {
      "file": "SKILL.md",
      "startLine": 17,
      "endLine": 17,
      "quote": "quantity 缺失时取 1，明确提供的 0 保持为 0。sku 必须是去除两端空白后长度为 1–100 的字符串。"
    }
